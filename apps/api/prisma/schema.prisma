// Esquema minimo de Fase 1 / Paso 1: usuarios, autenticacion, cuentas, categorias,
// transacciones y auditoria. El resto de entidades (merchants, reglas, transferencias,
// recurrentes, presupuestos, objetivos, imports...) se anaden en los siguientes pasos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CARD
  DIGITAL
  CASH
  INVESTMENT
  DEPOSIT
  LOAN
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_LOCKED
  REGISTER
  LOGOUT
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_DELETED
  IMPORT_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_DELETED
  RULE_CREATED
  RULE_UPDATED
  RULE_DELETED
  TRANSFER_STATUS_CHANGED
}

enum InternalTransferStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum RuleField {
  DESCRIPTION
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  OTHER
}

enum RuleOperator {
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  EXACT
  REGEX
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  totpSecretEncrypted String? @map("totp_secret_encrypted")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  accounts            Account[]
  categories          Category[]
  auditLogs           AuditLog[]
  imports             Import[]
  merchants           Merchant[]
  classificationRules ClassificationRule[]
  internalTransfers   InternalTransfer[]
  recurringGroups     RecurringGroup[]

  @@map("users")
}

model Account {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  name        String
  entity      String?
  alias       String?
  type        AccountType
  currency    String      @default("EUR")
  balance     Decimal     @default(0) @db.Decimal(14, 2)
  balanceDate DateTime?   @map("balance_date")
  isActive    Boolean     @default(true) @map("is_active")
  externalId  String?     @map("external_id")
  ibanMask    String?     @map("iban_mask")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  imports             Import[]
  classificationRules ClassificationRule[]
  recurringGroups     RecurringGroup[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id       String  @id @default(uuid())
  userId   String? @map("user_id")
  name     String
  parentId String? @map("parent_id")
  isSystem Boolean @default(false) @map("is_system")

  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent              Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]           @relation("CategoryHierarchy")
  transactions        Transaction[]
  merchantDefaults    Merchant[]
  classificationRules ClassificationRule[]
  recurringGroups     RecurringGroup[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  categoryId            String?   @map("category_id")
  merchantId            String?   @map("merchant_id")
  recurringGroupId      String?   @map("recurring_group_id")
  date                  DateTime
  valueDate             DateTime? @map("value_date")
  originalDescription   String    @map("original_description")
  normalizedDescription String?   @map("normalized_description")
  amount                Decimal   @db.Decimal(14, 2)
  currency              String    @default("EUR")
  isIncome              Boolean   @default(false) @map("is_income")
  isExpense             Boolean   @default(false) @map("is_expense")
  isInternalTransfer    Boolean   @default(false) @map("is_internal_transfer")
  classificationSource  String?   @map("classification_source")
  confidence            Decimal?  @db.Decimal(4, 3)
  notes                 String?
  sourceFile            String?   @map("source_file")
  externalReference     String?   @map("external_reference")
  fingerprint           String
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  merchant       Merchant?       @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  recurringGroup RecurringGroup? @relation(fields: [recurringGroupId], references: [id], onDelete: SetNull)

  outgoingTransfer InternalTransfer? @relation("OutgoingTransfer")
  incomingTransfer InternalTransfer? @relation("IncomingTransfer")

  @@unique([accountId, fingerprint])
  @@index([accountId])
  @@index([categoryId])
  @@index([merchantId])
  @@index([recurringGroupId])
  @@map("transactions")
}

// Propuesta o confirmacion de transferencia interna entre dos cuentas del mismo usuario.
// "confirmedVia" distingue una autoconfirmacion del motor (confianza alta) de una confirmacion
// manual del usuario, siguiendo el mismo principio de transparencia que ClassificationRule.
// isInternalTransfer en Transaction SOLO se activa mientras esta CONFIRMED: pendiente o
// rechazada, el movimiento sigue contando como ingreso/gasto normal.
model InternalTransfer {
  id                     String                  @id @default(uuid())
  userId                 String                  @map("user_id")
  outgoingTransactionId  String                  @unique @map("outgoing_transaction_id")
  incomingTransactionId  String                  @unique @map("incoming_transaction_id")
  status                 InternalTransferStatus  @default(PENDING)
  confidence             Decimal                 @db.Decimal(4, 3)
  confirmedVia           String?                 @map("confirmed_via")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransaction Transaction @relation("OutgoingTransfer", fields: [outgoingTransactionId], references: [id], onDelete: Cascade)
  incomingTransaction Transaction @relation("IncomingTransfer", fields: [incomingTransactionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("internal_transfers")
}

// Catalogo personal de comercios del usuario. Los alias son patrones (contains, sobre la
// descripcion normalizada) que identifican al comercio en distintos formatos bancarios:
// "MERCADONA 4287", "MERCADONA ES", "COMPRA MERCADONA" -> mismo Merchant "Mercadona".
model Merchant {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  name              String
  defaultCategoryId String?  @map("default_category_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?        @relation(fields: [defaultCategoryId], references: [id])
  aliases         MerchantAlias[]
  transactions    Transaction[]
  recurringGroups RecurringGroup[]

  @@unique([userId, name])
  @@index([userId])
  @@map("merchants")
}

model MerchantAlias {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  pattern    String
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, pattern])
  @@index([merchantId])
  @@map("merchant_aliases")
}

// Reglas deterministas de clasificacion, con prioridad sobre cualquier automatizacion futura
// basada en IA (Fase 4). "createdVia" distingue una regla escrita a mano de una generada al
// aceptar la sugerencia de "crear regla" desde una correccion manual (igualmente editable).
model ClassificationRule {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  field      RuleField    @default(DESCRIPTION)
  operator   RuleOperator
  value      String
  accountId  String?      @map("account_id")
  minAmount  Decimal?     @map("min_amount") @db.Decimal(14, 2)
  maxAmount  Decimal?     @map("max_amount") @db.Decimal(14, 2)
  categoryId String       @map("category_id")
  priority   Int          @default(100)
  isActive   Boolean      @default(true) @map("is_active")
  createdVia String       @default("manual") @map("created_via")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@map("classification_rules")
}

// Patron de gasto recurrente detectado (o creado a mano). "description" es la clave alternativa
// de agrupacion cuando no hay comercio identificado; cuando lo hay, se agrupa por merchantId.
// isManual distingue un grupo creado explicitamente por el usuario (POST /recurring/manual) de
// uno propuesto por el detector; ambos son igual de editables/desactivables despues.
model RecurringGroup {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  accountId         String             @map("account_id")
  merchantId        String?            @map("merchant_id")
  categoryId        String?            @map("category_id")
  description       String
  frequency         RecurringFrequency
  typicalAmount     Decimal            @map("typical_amount") @db.Decimal(14, 2)
  lastDate          DateTime           @map("last_date")
  nextEstimatedDate DateTime?          @map("next_estimated_date")
  isActive          Boolean            @default(true) @map("is_active")
  isManual          Boolean            @default(false) @map("is_manual")
  confidence        Decimal?           @db.Decimal(4, 3)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  merchant     Merchant?     @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([accountId])
  @@map("recurring_groups")
}

// Registro de una importacion confirmada (auditoria de "importaciones"). El preview no persiste
// nada: solo se crea este registro, junto con las transacciones, al confirmar.
model Import {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  accountId      String   @map("account_id")
  filename       String
  totalRows      Int      @map("total_rows")
  importedCount  Int      @map("imported_count")
  duplicateCount Int      @map("duplicate_count")
  errorCount     Int      @map("error_count")
  createdAt      DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("imports")
}

// Tabla usada por connect-pg-simple para almacenar sesiones de express-session.
// Se declara aqui (en vez de dejar que la cree automaticamente) para que quede
// bajo control de las migraciones de Prisma y no genere drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model AuditLog {
  id        String         @id @default(uuid())
  userId    String?        @map("user_id")
  eventType AuditEventType @map("event_type")
  metadata  Json?
  ip        String?
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@map("audit_logs")
}
