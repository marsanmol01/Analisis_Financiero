# Copia este fichero a .env y rellena los valores. .env nunca debe subirse a Git.

# --- Base de datos ---
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=changeme
POSTGRES_DB=plataforma_financiera
POSTGRES_PORT=5432
DATABASE_URL="postgresql://finanzas:changeme@localhost:5432/plataforma_financiera?schema=public"

# --- API ---
NODE_ENV=development
API_PORT=3000
# Origen(es) permitido(s) para CORS, separados por coma. Al desplegar con Docker + Tailscale,
# añade aqui la URL https de Tailscale del frontend (ver docs/deployment.md), sin quitar la de
# desarrollo si sigues usando "npm run dev" en local.
WEB_ORIGIN=http://localhost:5173

# Puerto del host donde se publica el frontend (nginx) al levantar docker-compose.
WEB_PORT=8080

# Secreto para firmar la cookie de sesion. Generar con: openssl rand -base64 48
SESSION_SECRET=changeme-generate-a-long-random-value

# Clave AES-256 (32 bytes en base64) para cifrar en reposo el secreto TOTP del 2FA.
# Generar con: openssl rand -base64 32
ENCRYPTION_KEY=changeme-generate-a-32-byte-base64-key

# Politica de bloqueo por intentos fallidos de login
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Frontend (Vite) ---
# En desarrollo ("npm run dev"), la URL absoluta de la API: http://localhost:3000
# En Docker/producción, nginx reenvia /api/* a la API dentro de la red de Docker, asi que basta
# con una ruta relativa: /api (mismo origen que la propia app, sea localhost, LAN o Tailscale).
# Se hornea en el build (docker-compose build web), asi que hay que reconstruir la imagen si
# cambia (ver docs/deployment.md).
VITE_API_URL=http://localhost:3000
