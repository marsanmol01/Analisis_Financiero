# Copia este fichero a .env y rellena los valores. .env nunca debe subirse a Git.

# --- Base de datos ---
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=changeme
POSTGRES_DB=plataforma_financiera
POSTGRES_PORT=5432
DATABASE_URL="postgresql://finanzas:changeme@localhost:5432/plataforma_financiera?schema=public"

# --- API ---
NODE_ENV=development
API_PORT=3000
# Origen(es) permitido(s) para CORS, separados por coma
WEB_ORIGIN=http://localhost:5173

# Secreto para firmar la cookie de sesion. Generar con: openssl rand -base64 48
SESSION_SECRET=changeme-generate-a-long-random-value

# Politica de bloqueo por intentos fallidos de login
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
